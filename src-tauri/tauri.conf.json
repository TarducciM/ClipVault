{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "0.1.0",
  "identifier": "com.clipvault.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipVault",
        "width": 420,
        "height": 560,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Impostazioni ClipVault",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
